// Worker de homologação (AD-18, história 1.6): o build web (`dist/`) e o proxy de
// `/api/*` na mesma origem. A CI publica a cada merge na `main` (job deploy-homolog).
// O segredo de proxy não fica aqui: vai pelo `wrangler secret put PROXY_SECRET`.
{
  "name": "fluveny-homolog",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "API_ORIGIN": "https://fluveny-api-homolog.onrender.com",
  },
}
