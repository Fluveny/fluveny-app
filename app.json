{
  "expo": {
    "name": "Fluveny",
    "slug": "fluveny-app",
    "owner": "fluveny",
    "scheme": "fluveny",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "br.edu.unifal.fluveny",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6FC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "@sentry/react-native",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Fluveny usa o microfone para conferir a sua fala nas atividades. O áudio não é gravado nem guardado.",
          "speechRecognitionPermission": "O Fluveny usa o reconhecimento de voz do sistema para transcrever a sua fala nas atividades; ele pode enviar o áudio ao Google ou à Apple. O Fluveny não grava nem guarda o áudio."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "64e6cd9d-2608-4fc6-964a-23f784c9107c"
      }
    }
  }
}
