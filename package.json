{
  "name": "fluveny-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "eslint .",
    "typecheck": "npm run -s routes:types && tsc --noEmit",
    "test": "jest",
    "api:sync": "node scripts/api-sync.mjs",
    "api:check": "node scripts/api-check.mjs",
    "api:types": "node scripts/api-types.mjs",
    "design:sync": "node scripts/design-sync.mjs",
    "api:tools": "npm ci --prefix tools/openapi-types --ignore-scripts",
    "routes:types": "expo customize tsconfig.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "~5.107.1",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/tools/"
    ]
  }
}
