# Copie para .env.local e ajuste. Nenhum valor aqui é segredo.
# Base da API (sem barra no fim). No web: http://localhost:8080.
# No emulador Android, 10.0.2.2 é o host (a sua máquina) visto de dentro do emulador: http://10.0.2.2:8080.
# Num aparelho físico, use o IP da máquina na rede (por exemplo, http://192.168.0.10:8080). HTTP sem TLS
# só funciona em build de debug; os builds de release exigem HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Opcional. Sem ele, o Sentry fica desligado.
EXPO_PUBLIC_SENTRY_DSN=
# Opcional. Nome do ambiente no Sentry (homolog, prod).
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Opcional. Endereço que o botão ATUALIZAR abre no Android. Padrão: a página do pacote na Play.
EXPO_PUBLIC_STORE_URL=
# Opcional. Com 1, o App responde a API com os mocks de src/api/mocks (MSW) e abre sem a API no ar.
# Mantenha o EXPO_PUBLIC_API_URL preenchido: no Android, o mock só intercepta URL absoluta.
EXPO_PUBLIC_API_MOCK=
